# ============================================
# CONFIGURACIÓN DE EJEMPLO - application.properties
# ============================================
# Copia este archivo a application.properties y configura los valores

spring.application.name=fossiles-core-backend

# ============================================
# DATABASE CONFIGURATION (AWS RDS)
# ============================================
spring.datasource.url=jdbc:postgresql://TU_RDS_ENDPOINT:5432/db
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# ============================================
# JPA/HIBERNATE CONFIGURATION
# ============================================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.use_sql_comments=true

# ============================================
# SERVER CONFIGURATION
# ============================================
server.port=8080

# ============================================
# JWT CONFIGURATION
# ============================================
jwt.secret=TU_JWT_SECRET_MINIMO_256_BITS
jwt.expiration=86400000
jwt.access-expiration=3600000
jwt.refresh-expiration=7776000000

# ============================================
# ENCRYPTION CONFIGURATION (AES)
# ============================================
# IMPORTANTE: Esta clave debe ser EXACTAMENTE la misma que ENCRYPTION_KEY en encryptionService.js del frontend
encryption.key=gdfgsgdfgdf
encryption.algorithm=AES
encryption.transformation=AES/CBC/PKCS5Padding

# ============================================
# AWS S3 CONFIGURATION
# ============================================
# OPCIÓN 1: Configurar directamente en este archivo (NO RECOMENDADO para producción)
# app.s3.bucket=fossiles-bkt
# app.s3.prefix=materiales/
# app.s3.region=us-east-2
# app.s3.access-key-id=TU_ACCESS_KEY_ID
# app.s3.secret-access-key=TU_SECRET_ACCESS_KEY

# OPCIÓN 2: Usar variables de entorno (RECOMENDADO)
# Configura las siguientes variables de entorno:
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# Y configura solo estos valores:
app.s3.bucket=fossiles-bkt
app.s3.prefix=materiales/
app.s3.region=us-east-2
app.s3.access-key-id=${AWS_ACCESS_KEY_ID:}
app.s3.secret-access-key=${AWS_SECRET_ACCESS_KEY:}
app.s3.enabled=true

# OPCIÓN 3: Usar credenciales por defecto de AWS (IAM Role, ~/.aws/credentials)
# Solo configura estos valores y deja las credenciales vacías:
# app.s3.bucket=fossiles-bkt
# app.s3.prefix=materiales/
# app.s3.region=us-east-2
# app.s3.enabled=true

# ============================================
# FEL — Consulta NIT receptores (POS / facturación)
# ============================================
fel.receptor.url=https://consultareceptores.feel.com.gt/rest/action
fel.receptor.emisor-codigo=${FEL_EMISOR_CODIGO:}
fel.receptor.emisor-clave=${FEL_EMISOR_CLAVE:}
fel.receptor.enabled=true

# FEL — Emisión DTE (POS: generar XML, firmar y certificar FACT)
#
# fel.emission.test-mode es un apagador de EMERGENCIA: si es true, TODAS las ventas certifican
# con las credenciales fel.emission.sandbox.* sin importar el flag por kiosko. En false (normal
# una vez que hay kioskos productivos), cada venta certifica con:
#   - fel.emission.* (producción)  si locations.pos_test_mode = false
#   - fel.emission.sandbox.*       si locations.pos_test_mode = true (piloto, sin validez fiscal)
# Ese flag se activa/desactiva por kiosko en Catálogos → Ubicaciones → "Modo piloto POS", sin
# reiniciar el servidor. Ventas online y facturación manual usan siempre fel.emission.* (producción),
# salvo que el apagador global test-mode esté activo.
fel.emission.enabled=true
fel.emission.test-mode=false
fel.emission.required=false
fel.emission.sign-url=https://signer-emisores.feel.com.gt/sign_solicitud_firmas/firma_xml
fel.emission.certify-url=https://certificador.feel.com.gt/fel/certificacion/v2/dte/

# Credenciales de PRODUCCIÓN INFILE (kioskos con pos_test_mode=false):
fel.emission.sign-key=${FEL_SIGN_KEY:}
fel.emission.sign-alias=${FEL_SIGN_ALIAS:}
fel.emission.cert-usuario=${FEL_CERT_USUARIO:}
fel.emission.cert-llave=${FEL_CERT_LLAVE:}
fel.emission.nit-emisor=${FEL_NIT_EMISOR:}
# Nombre legal emisor (UTF-8). En variables de entorno use FEL_NOMBRE_EMISOR con UTF-8,
# o sin tildes: CUEROGLAM, SOCIEDAD ANONIMA. Unicode: AN\u00D3NIMA = ANÓNIMA
fel.emission.nombre-emisor=${FEL_NOMBRE_EMISOR:CUEROGLAM, SOCIEDAD AN\u00D3NIMA}
fel.emission.nombre-comercial=${FEL_NOMBRE_COMERCIAL:CUEROGLAM}
fel.emission.correo-emisor=${FEL_CORREO_EMISOR:}
fel.emission.afiliacion-iva=GEN
# Fallback si la ubicación no tiene fel_establishment_code; cada kiosko lo define en BD/UI:
fel.emission.codigo-establecimiento=1
fel.emission.direccion=${FEL_DIRECCION_EMISOR:DIAGONAL 29 00-22 17 CALZADA LA PAZ Guatemala, GUATEMALA}
fel.emission.codigo-postal=0
fel.emission.municipio=Guatemala
fel.emission.departamento=GUATEMALA
fel.emission.pais=GT
fel.emission.document-type=FACT
fel.emission.moneda=GTQ

# Reporte de movimientos bancarios (depósitos de ventas en efectivo)
kiosk-pos.deposit-report.bank-account=061-0016829-2
kiosk-pos.deposit-report.account-name=CUEROGLAM, S.A.
kiosk-pos.deposit-report.bank-name=Banco G&T Continental

# Reporte de voucher (ventas con tarjeta)
kiosk-pos.voucher-report.default-card-brand=VISA

fel.emission.frases[0].tipo=1
fel.emission.frases[0].escenario=1
fel.emission.frases[1].tipo=4
fel.emission.frases[1].escenario=1
# NO usar frase tipo 2 escenario 1 con afiliación GEN (error SAT 2614).

# Credenciales SANDBOX/implementación INFILE (kioskos con pos_test_mode=true, aún piloto).
# Si se dejan en blanco, el backend autocompleta las credenciales demo públicas de INFILE.
fel.emission.sandbox.sign-key=
fel.emission.sandbox.sign-alias=
fel.emission.sandbox.cert-usuario=
fel.emission.sandbox.cert-llave=
fel.emission.sandbox.nit-emisor=
fel.emission.sandbox.nombre-emisor=
fel.emission.sandbox.nombre-comercial=
fel.emission.sandbox.afiliacion-iva=GEN
fel.emission.sandbox.direccion=
fel.emission.sandbox.municipio=Guatemala
fel.emission.sandbox.departamento=GUATEMALA

