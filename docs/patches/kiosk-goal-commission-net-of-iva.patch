@@ -0,0 +1,77 @@
+package com.fossiles.fossilescorebackend.application.service;
+
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.YearMonth;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Comision de encargada / supervisora: el 2 % se calcula sobre la venta SIN IVA (total vendido / 1.12) desde
+ * septiembre 2026; antes, sobre el total vendido. Bonos fijos y % de meta no cambian (se miden con el total vendido).
+ */
+class KioskGoalServiceCommissionTest {
+
+    private final KioskGoalService service = new KioskGoalService(null, null, null, null, null, null, null);
+
+    private static final YearMonth SEP_2026 = YearMonth.of(2026, 9);
+    private static final YearMonth AUG_2026 = YearMonth.of(2026, 8);
+
+    @Test
+    void encargadaCommissionFromSeptember2026IsTwoPercentOfSalesWithoutIva() {
+        // Miraflores II, septiembre 2026: vendio 84,226.40 de una meta de 120,000 (70.2 %): nivel 1, sin bono
+        KioskGoalService.CommissionResult r = service.computeEncargadaCommission(
+                new BigDecimal("120000"), new BigDecimal("84226.40"), SEP_2026);
+
+        assertThat(r.getTier()).isEqualTo("TIER1");
+        assertThat(r.getPercentAchieved()).isEqualByComparingTo("70.2");
+        assertThat(r.getCommissionAmount()).isEqualByComparingTo("1504.04"); // 84,226.40 / 1.12 x 2 %
+    }
+
+    @Test
+    void previousMonthsAndNoPeriodKeepTheOldRuleOverTotalSold() {
+        BigDecimal goal = new BigDecimal("120000");
+        BigDecimal sold = new BigDecimal("84226.40");
+
+        assertThat(service.computeEncargadaCommission(goal, sold, AUG_2026).getCommissionAmount())
+                .isEqualByComparingTo("1684.53"); // 84,226.40 x 2 %
+        assertThat(service.computeEncargadaCommission(goal, sold).getCommissionAmount())
+                .isEqualByComparingTo("1684.53");
+        assertThat(service.computeEncargadaCommission(goal, sold, null).getCommissionAmount())
+                .isEqualByComparingTo("1684.53");
+    }
+
+    @Test
+    void fixedBonusesAreUnchangedAndAddedOnTopOfTheNetCommission() {
+        // 100 % de la meta: bono Q800 + 2 % de (100,000 / 1.12)
+        KioskGoalService.CommissionResult tier3 = service.computeEncargadaCommission(
+                new BigDecimal("100000"), new BigDecimal("100000"), SEP_2026);
+        assertThat(tier3.getTier()).isEqualTo("TIER3");
+        assertThat(tier3.getCommissionAmount()).isEqualByComparingTo("2585.71"); // 800 + 1,785.71
+
+        // 90 % de la meta: bono Q500 + 2 % de (90,000 / 1.12)
+        KioskGoalService.CommissionResult tier2 = service.computeEncargadaCommission(
+                new BigDecimal("100000"), new BigDecimal("90000"), SEP_2026);
+        assertThat(tier2.getTier()).isEqualTo("TIER2");
+        assertThat(tier2.getCommissionAmount()).isEqualByComparingTo("2107.14"); // 500 + 1,607.14
+    }
+
+    @Test
+    void belowSeventyPercentThereIsNoCommissionInAnyPeriod() {
+        assertThat(service.computeEncargadaCommission(new BigDecimal("100000"), new BigDecimal("69999"), SEP_2026)
+                .getCommissionAmount()).isEqualByComparingTo("0");
+    }
+
+    @Test
+    void supervisoraAggregateCommissionAlsoUsesSalesWithoutIvaFromSeptember2026() {
+        // meta agregada 200,000, vendido agregado 200,000 (100 %): bono Q200 + 2 % de (200,000 / 1.12)
+        KioskGoalService.CommissionResult r = service.computeSupervisoraCommission(
+                new BigDecimal("200000"), new BigDecimal("200000"), SEP_2026);
+
+        assertThat(r.getTier()).isEqualTo("TIER3");
+        assertThat(r.getCommissionAmount()).isEqualByComparingTo("3771.43"); // 200 + 3,571.43
+        assertThat(service.computeSupervisoraCommission(new BigDecimal("200000"), new BigDecimal("200000"), AUG_2026)
+                .getCommissionAmount()).isEqualByComparingTo("4200.00"); // 200 + 4,000
+    }
+}
